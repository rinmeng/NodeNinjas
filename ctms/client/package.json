{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:15000",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cra-template": "1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "start": "DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "css": "npx tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "dev": "concurrently \"npm run start\" \"npm run css\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
